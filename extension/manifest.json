{
  "manifest_version": 3,
  "name": "OTS — Offensive Text Scanner",
  "version": "0.2.0",
  "description": "Scan visible text and images on the current page for offensive content via a ViLT multimodal model.",
  "permissions": ["activeTab", "storage", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icon.png",
      "48": "public/icon.png",
      "128": "public/icon.png"
    }
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
