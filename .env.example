# OTS runtime configuration
OTS_MODEL_DIR=./checkpoints/vilt-offense
OTS_DEVICE=cuda
OTS_BATCH_SIZE=16
OTS_BATCH_WINDOW_MS=10
OTS_USE_FUSED_KERNELS=1

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# API
OTS_API_TOKEN=dev-token-change-me
OTS_RATE_LIMIT_PER_MIN=120
OTS_CORS_ORIGINS=chrome-extension://*,http://localhost:*

# OCR
OTS_OCR_MIN_CONF=0.6
OTS_OCR_MIN_CHARS=2
